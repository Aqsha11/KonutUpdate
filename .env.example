APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@konutupdate.com"
MAIL_FROM_NAME="KonutUpdate"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile — daftar di https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_ENABLED=false mematikan captcha (hanya untuk development). JANGAN diset false di produksi.
# Di bawah memakai dummy key resmi Cloudflare yang selalu lolos, supaya dev lokal tetap bisa login/daftar.
# PENTING: site key (22 char) dan secret key (35 char) berbeda panjangnya — jangan tertukar.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google Gemini — untuk fitur publik "Tanya Berita" (chat AI pencarian berita).
# Ambil API key di https://aistudio.google.com/apikey . Kosongkan untuk menyembunyikan fitur.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Model cadangan (dipisah koma) jika model utama deprecated/penuh.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-2.5-flash-lite
# Batas anggaran global panggilan AI per hari (0 = tanpa batas).
GEMINI_DAILY_LIMIT=1000
# Jumlah pertanyaan gratis untuk tamu (belum login) sebelum diminta masuk/daftar (0 = wajib login).
GEMINI_GUEST_LIMIT=2
